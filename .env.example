# ─── Gemini / Vertex AI — pick ONE auth mode ──────────────────────────────────

# Option A: Google AI Studio key (fastest for hackathon)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_ai_studio_key_here

# Option B: Vertex AI (needed for Imagen 3, Lyria 3, Agent Engine)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev (default — SQLite, no setup needed)
# DATABASE_URL=sqlite+aiosqlite:///./cineops.db

# Cloud SQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@/dbname?host=/cloudsql/project:region:instance

# ─── MCP Server URL (API Gateway needs this to proxy to MCP server) ───────────
MCP_SERVER_URL=http://localhost:8001

# ─── Grafana Cloud ────────────────────────────────────────────────────────────
# Service account token with annotations:write scope
GRAFANA_URL=https://yourstack.grafana.net
GRAFANA_API_KEY=your_grafana_service_account_token

# ─── Cloud Storage ────────────────────────────────────────────────────────────
# Leave empty to save media files to ./media/ locally
GCS_BUCKET=
STORAGE_BACKEND=local

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Used in Next.js frontend — must be accessible from the browser
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_MCP_URL=http://localhost:8001

# ─── Demo mode ────────────────────────────────────────────────────────────────
# Hardcoded demo user (auth is skipped for the hackathon)
DEMO_USER_ID=demo-user-id
DEMO_PRODUCTION_ID=

# ─── Local media directory (for dev without GCS) ─────────────────────────────
LOCAL_MEDIA_DIR=./media
